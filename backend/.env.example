APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/santa_fe_capacita?sslmode=disable
FRONTEND_URL=http://localhost:5173
SESSION_TTL_HOURS=12
RESET_TTL_MINUTES=30

# Configuración de Servidor de Correo (SMTP)
# En desarrollo por defecto usa localhost:1025 (Mailpit / MailHog sin autenticación).
# Para producción, configurar servidor real (ej. Brevo, Zimbra provincial, Resend, Gmail):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Santa Fe Capacita <no-reply@santafe.gov.ar>
